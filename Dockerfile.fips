# FIPS 140-3 build of edge-endpoint, alongside the legacy Dockerfile.
#
# Ships only to Axon infra (794562053834.dkr.ecr.us-west-2.amazonaws.com/edge/edge-endpoint,
# replicated to 216731772508 for Axon-dev devices). The legacy Dockerfile keeps shipping
# to 767397850842 unchanged. Same repo name, no -fips suffix: the registry is the FIPS
# boundary, matching gl-edge-inference.
#
# Two stages: a `-dev` builder (has apk, a shell, and build tools) and a *distroless* prod
# stage. Nothing with a shell or a package manager reaches the shipped image.
#
# This one image serves every role in the edge-endpoint Deployment except apply-edge-config
# (busybox). TokenManager writers (edge-endpoint, status-monitor, escalation-queue-reader,
# inference-model-updater) run as USER 65532 so the shared token cache stays readable by
# FIPS GEP. mount-s3 is privileged and runAsUser 0 in the chart (FUSE).
#
# Base image pins: MUST be date-stamped tags, never mutable ones. The mutable
# python-fips:3.11 tag is frozen at 2025-08-22 (~11 months stale) and its OpenSSL
# (3.5.2-r1) is older than the apk repo the image points at (3.6.3-r3), so `apk add` there
# silently upgrades libcrypto out from under the FIPS provider. Same-date dev and non-dev
# pins keep the builder and prod OpenSSL/Python identical.
# Re-resolve with: deploy/bin/resolve-chainguard-tag.sh python-fips 3.11-dev
ARG PY_FIPS_DEV=cgr.dev/axon.com/python-fips:3.11-dev-202607290026@sha256:6b0bf611cd0cbd1416f72cac1e42ef53494c1ecd25ccf18cab65165242e61e65
ARG PY_FIPS=cgr.dev/axon.com/python-fips:3.11-202607290027@sha256:c111eb2b12b2fa86c6bb9c3c9e0f11daeb895d8a58509504805d1d81b5213f12

ARG NGINX_PORT=30101
ARG NGINX_PORT_OLD=6717
ARG UVICORN_PORT=6718
ARG APP_ROOT="/groundlight-edge"

######################
# React Build Stage
######################
FROM node:20-slim AS react-build-stage
WORKDIR /react-app
COPY app/status_monitor/frontend/package.json app/status_monitor/frontend/package-lock.json ./
RUN npm ci
COPY app/status_monitor/frontend/ ./
RUN npm run build

########################################
# mount-s3 glibc bundle (AWS's binary)
########################################
# Mountpoint for S3 is published as a glibc Debian package, not a Wolfi apk. Stage it
# and its loader/libs under /opt/aws-mount-s3 so they cannot overwrite the FIPS
# libcrypto3/libssl3 in /usr/lib. The Python launcher invokes the glibc loader with
# an isolated --library-path.
#
# Residual risk: TLS inside mount-s3 is AWS's crypto, not Chainguard's FIPS Python
# OpenSSL. Infosec still needs to decide whether that sits behind a FIPS claim.
#
# Residual risk: nginx self-signed certs are generated by the PyPI `cryptography`
# wheel (rsa.generate_private_key / X.509 SHA-256). That wheel often statically
# links its own OpenSSL, which the libssl* file scan cannot see.
# verify-fips-image.sh compares ssl.OPENSSL_VERSION to cryptography's OpenSSL and
# reports a mismatch. Infosec still needs to decide whether local nginx TLS sits
# behind a FIPS claim.
FROM debian:bookworm-slim AS mount-s3-deb
ARG TARGETARCH
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) MOUNT_S3_ARCH=x86_64 ;; \
      *) echo "FIPS edge-endpoint is linux/amd64 only (got TARGETARCH=$TARGETARCH)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://s3.amazonaws.com/mountpoint-s3-release/latest/${MOUNT_S3_ARCH}/mount-s3.deb" -o /tmp/mount-s3.deb && \
    apt-get update && apt-get install -y --no-install-recommends /tmp/mount-s3.deb && \
    rm /tmp/mount-s3.deb && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/aws-mount-s3/bin /opt/aws-mount-s3/lib /opt/aws-mount-s3/lib64 && \
    cp /usr/bin/mount-s3 /opt/aws-mount-s3/bin/mount-s3 && \
    ldd /usr/bin/mount-s3 | awk 'NF==4 && $3 ~ /^\// {print $3} NF==2 && $1 ~ /^\// {print $1}' \
      | while read -r lib; do \
          base=$(basename "$lib"); \
          if echo "$base" | grep -q '^ld-linux'; then \
            cp -v "$lib" "/opt/aws-mount-s3/lib64/$base"; \
          else \
            cp -v "$lib" "/opt/aws-mount-s3/lib/$base"; \
          fi; \
        done

###############
# Build stage
###############
FROM ${PY_FIPS_DEV} AS builder

ARG APP_ROOT

USER root

ENV UV_PYTHON=/usr/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    PATH=${APP_ROOT}/.venv/bin:$PATH

RUN apk add --no-cache uv

# Stage nginx into a chroot so it can be COPYed into distroless. Same package names as
# gep/glruntime/Dockerfile.fips: Wolfi has no plain `nginx` package, and `nginx-config`
# is ambiguous without pinning nginx-mainline-config.
RUN mkdir -p /runtime-apks/etc/apk && \
    cp /etc/apk/repositories /runtime-apks/etc/apk/repositories && \
    cp -r /etc/apk/keys /runtime-apks/etc/apk/keys && \
    apk add --no-cache --no-scripts --initdb --root /runtime-apks \
        nginx-mainline nginx-mainline-config

RUN /usr/bin/openssl-fips-test && \
    test -f /etc/ssl/fipsmodule.cnf && \
    test -f /usr/lib/ossl-modules/fips.so && \
    apk info -v libcrypto3 && apk info -v libssl3

WORKDIR ${APP_ROOT}

COPY ./pyproject.toml ./uv.lock ${APP_ROOT}/
RUN uv sync --frozen --no-install-project --no-group dev --no-group lint && \
    uv cache clean

RUN mkdir -p /etc/groundlight/edge-config \
             /etc/groundlight/inference-deployment \
             /opt/groundlight/edge/sqlite \
             /runtime-apks/var/lib/nginx/tmp/client_body \
             /runtime-apks/var/lib/nginx/tmp/proxy \
             /runtime-apks/var/lib/nginx/tmp/fastcgi \
             /runtime-apks/var/lib/nginx/tmp/uwsgi \
             /runtime-apks/var/lib/nginx/tmp/scgi \
             /staged/etc/nginx/certs && \
    touch /staged/etc/nginx/certs/.keep

COPY configs ${APP_ROOT}/configs
COPY app/templates/inference_deployment_template.yaml \
    /etc/groundlight/inference-deployment/

# Confirm the venv interpreter is the base image's FIPS python and that no dependency
# vendored its own OpenSSL (which would bypass the FIPS provider).
RUN set -eu; \
    _SSL_SO=$(.venv/bin/python -c 'import _ssl; print(_ssl.__file__)'); \
    readelf -d "$_SSL_SO" | grep -q 'libssl.so' \
      || (echo "FIPS VIOLATION: venv _ssl does not dynamically link system libssl" && exit 1); \
    found=$(find .venv \( -name 'libcrypto*' -o -name 'libssl*' \) -print); \
    test -z "$found" \
      || (echo "FIPS VIOLATION: vendored OpenSSL in venv: $found" && exit 1)

####################
# Production stage
####################
FROM ${PY_FIPS} AS prod

ARG APP_ROOT
ARG NGINX_PORT
ARG NGINX_PORT_OLD
ARG UVICORN_PORT

COPY --from=builder /runtime-apks/usr/bin/nginx /usr/bin/nginx
COPY --from=builder /runtime-apks/usr/lib/nginx/ /usr/lib/nginx/
COPY --from=builder /runtime-apks/usr/lib/libpcre2-8.so.0* /usr/lib/

COPY --from=builder --chown=65532:65532 /runtime-apks/etc/nginx/ /etc/nginx/
COPY --from=builder --chown=65532:65532 /runtime-apks/var/lib/nginx/ /var/lib/nginx/
COPY --from=builder --chown=65532:65532 /staged/etc/nginx/certs/ /etc/nginx/certs/

COPY --from=mount-s3-deb /opt/aws-mount-s3/ /opt/aws-mount-s3/

COPY --from=builder --chown=65532:65532 ${APP_ROOT} ${APP_ROOT}
COPY --from=builder --chown=65532:65532 /etc/groundlight /etc/groundlight
COPY --from=builder --chown=65532:65532 /opt/groundlight/edge /opt/groundlight/edge

COPY --chown=65532:65532 /app ${APP_ROOT}/app/
COPY --from=react-build-stage --chown=65532:65532 /react-app/dist ${APP_ROOT}/app/status_monitor/react-build
COPY --chown=65532:65532 /deploy ${APP_ROOT}/deploy/
COPY --chown=65532:65532 /licenses ${APP_ROOT}/licenses/
COPY --chown=65532:65532 /README.md ${APP_ROOT}/README.md

COPY --from=builder --chown=65532:65532 ${APP_ROOT}/configs/nginx.conf /etc/nginx/nginx.conf

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=${APP_ROOT}/.venv/bin:$PATH \
    APP_PORT=${UVICORN_PORT}

WORKDIR ${APP_ROOT}
USER 65532

LABEL ai.groundlight.fips="true"

ENTRYPOINT []
CMD ["python", "-m", "uvicorn", "--workers", "8", "--host", "0.0.0.0", "--port", "6718", "--proxy-headers", "app.main:app"]

EXPOSE ${NGINX_PORT} ${NGINX_PORT_OLD} 443
